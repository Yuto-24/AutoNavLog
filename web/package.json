{
  "name": "autonavlog-web",
  "private": true,
  "version": "1.11.0",
  "type": "module",
  "scripts": {
    "generate:release-notes": "node scripts/generate-release-notes.mjs",
    "predev": "npm run generate:release-notes",
    "prebuild": "npm run generate:release-notes",
    "pretypecheck": "npm run generate:release-notes",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test:release-notes": "node --test scripts/generate-release-notes.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "5.3.0",
    "leaflet": "1.9.4",
    "lucide-react": "1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/leaflet": "1.9.22",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
