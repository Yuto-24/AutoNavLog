{
  "name": "autonavlog-web",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:release-notes": "node scripts/generate-release-notes.mjs",
    "predev": "npm run generate:release-notes",
    "prebuild": "npm run generate:release-notes",
    "pretypecheck": "npm run generate:release-notes",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test:release-notes": "node --test scripts/generate-release-notes.test.mjs",
    "test:e2e": "playwright test",
    "dev:local": "VITE_CALCULATION_MODE=local vite --host 127.0.0.1 --port 5174",
    "build:local": "npm run generate:release-notes && VITE_CALCULATION_MODE=local tsc -b && VITE_CALCULATION_MODE=local vite build --outDir dist-local",
    "prepare:local": "python3 ../scripts/prepare_local.py",
    "prebuild:local": "npm run prepare:local",
    "predev:local": "npm run generate:release-notes && npm run prepare:local",
    "test:local": "playwright test --config playwright.local.config.ts",
    "test:application": "playwright test --config playwright.application.config.ts",
    "test:auth": "playwright test --config playwright.auth.config.ts",
    "test:taf": "playwright test --config playwright.taf.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "5.3.0",
    "comlink": "4.4.2",
    "firebase": "12.19.0",
    "leaflet": "1.9.4",
    "lucide-react": "1.30.0",
    "pyodide": "0.27.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/leaflet": "1.9.22",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "fake-indexeddb": "6.2.5",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
