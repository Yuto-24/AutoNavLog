rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(subject) {
      return request.auth != null
        && request.auth.token.firebase.identities['google.com'].size() == 1
        && request.auth.token.firebase.identities['google.com'][0] == subject;
    }
    function valid(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['schema', 'id', 'version', 'revision', 'baseVersion', 'latestDeviceId', 'deletion', 'undoUntil', 'payload'])
        && d.schema == 1 && d.id == id && d.version is string && d.revision is int && d.revision > 0
        && d.payload is string && (d.latestDeviceId == null || d.latestDeviceId is string)
        && d.deletion in ['ACTIVE', 'PENDING_DELETE', 'DELETED']
        && (d.undoUntil == null || d.undoUntil is number)
        && (d.deletion != 'PENDING_DELETE'
          || (d.undoUntil is number && d.undoUntil <= request.time.toMillis() + 10000));
    }
    function deleted() {
      return resource.data.deletion == 'DELETED'
        || (resource.data.deletion == 'PENDING_DELETE'
          && resource.data.undoUntil <= request.time.toMillis());
    }
    match /googleAccounts/{subject}/projects/{id} {
      allow read: if owner(subject);
      allow create: if owner(subject) && valid(id) && request.resource.data.baseVersion == null && request.resource.data.revision == 1;
      allow update: if owner(subject) && valid(id)
        && request.resource.data.baseVersion == resource.data.version
        && request.resource.data.version != resource.data.version
        && request.resource.data.revision == resource.data.revision + 1
        && (resource.data.deletion != 'PENDING_DELETE'
          || request.resource.data.deletion != 'PENDING_DELETE'
          || request.resource.data.undoUntil == resource.data.undoUntil)
        && (!deleted() || request.resource.data.deletion == 'DELETED');
      // Durable tombstones are never physically deleted by browser clients.
      allow delete: if false;
    }
  }
}
