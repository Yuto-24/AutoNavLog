{
  "$defs": {
    "AdoptedSource": {
      "enum": [
        "AUTOMATIC",
        "MANUAL"
      ],
      "title": "AdoptedSource",
      "type": "string"
    },
    "AdoptedValue_datetime_": {
      "additionalProperties": false,
      "properties": {
        "adopted_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/AdoptedSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "automatic_metadata": {
          "additionalProperties": true,
          "title": "Automatic Metadata",
          "type": "object"
        },
        "automatic_status": {
          "$ref": "#/$defs/ValueState",
          "default": "UNAVAILABLE"
        },
        "automatic_value": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Automatic Value"
        },
        "manual_override": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manual Override"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "title": "AdoptedValue[datetime]",
      "type": "object"
    },
    "AdoptedValue_float_": {
      "additionalProperties": false,
      "properties": {
        "adopted_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/AdoptedSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "automatic_metadata": {
          "additionalProperties": true,
          "title": "Automatic Metadata",
          "type": "object"
        },
        "automatic_status": {
          "$ref": "#/$defs/ValueState",
          "default": "UNAVAILABLE"
        },
        "automatic_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
