        "variation_deg_east",
        "magnetic_course_deg",
        "wind_direction_deg_from",
        "wind_speed_kt",
        "wca_deg",
        "magnetic_heading_deg",
        "temperature_c",
        "cas_kt",
        "tas_kt",
        "ground_speed_kt",
        "zone_distance_nm",
        "cumulative_distance_nm",
