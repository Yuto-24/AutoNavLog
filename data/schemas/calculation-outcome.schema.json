{
  "$defs": {
    "AdoptedSource": {
      "enum": [
        "AUTOMATIC",
        "MANUAL"
      ],
      "title": "AdoptedSource",
      "type": "string"
    },
    "AdoptedValue_datetime_": {
      "additionalProperties": false,
      "properties": {
        "adopted_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/AdoptedSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "automatic_metadata": {
          "additionalProperties": true,
          "title": "Automatic Metadata",
          "type": "object"
        },
        "automatic_status": {
          "$ref": "#/$defs/ValueState",
          "default": "UNAVAILABLE"
        },
        "automatic_value": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Automatic Value"
        },
        "manual_override": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manual Override"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "title": "AdoptedValue[datetime]",
      "type": "object"
    },
    "AdoptedValue_float_": {
      "additionalProperties": false,
      "properties": {
        "adopted_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/AdoptedSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "automatic_metadata": {
          "additionalProperties": true,
          "title": "Automatic Metadata",
          "type": "object"
        },
        "automatic_status": {
          "$ref": "#/$defs/ValueState",
          "default": "UNAVAILABLE"
        },
        "automatic_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Automatic Value"
        },
        "manual_override": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manual Override"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "title": "AdoptedValue[float]",
      "type": "object"
    },
    "ArrivalAltitudeResult": {
      "additionalProperties": false,
      "properties": {
        "adopted_altitude_ft_msl": {
          "multipleOf": 100,
          "title": "Adopted Altitude Ft Msl",
          "type": "integer"
        },
        "adopted_source": {
          "$ref": "#/$defs/AdoptedSource"
        },
        "airport_elevation_ft_msl": {
          "minimum": 0,
          "title": "Airport Elevation Ft Msl",
          "type": "number"
        },
        "airport_elevation_rounded_ft_msl": {
          "minimum": 0,
          "multipleOf": 100,
          "title": "Airport Elevation Rounded Ft Msl",
          "type": "integer"
        },
        "automatic_altitude_ft_msl": {
          "multipleOf": 100,
          "title": "Automatic Altitude Ft Msl",
          "type": "integer"
        },
        "base_vrep_altitude_ft_msl": {
          "multipleOf": 100,
          "title": "Base Vrep Altitude Ft Msl",
          "type": "integer"
        },
        "boundary_tolerance_m": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 1.0,
          "title": "Boundary Tolerance M",
          "type": "number"
        },
        "derived_pattern_altitude_ft_msl": {
          "minimum": 100,
          "multipleOf": 100,
          "title": "Derived Pattern Altitude Ft Msl",
          "type": "integer"
        },
        "destination_airport_id": {
          "minLength": 1,
          "title": "Destination Airport Id",
          "type": "string"
        },
        "distance_nm_exact": {
          "minimum": 0,
          "title": "Distance Nm Exact",
          "type": "number"
        },
        "effective_distance_nm": {
          "minimum": 0,
          "title": "Effective Distance Nm",
          "type": "number"
        },
        "excess_distance_nm_exact": {
          "minimum": 0,
          "title": "Excess Distance Nm Exact",
          "type": "number"
        },
        "excess_distance_nm_rounded": {
          "minimum": 0,
          "title": "Excess Distance Nm Rounded",
          "type": "integer"
        },
        "manual_override_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manual Override Reason"
        },
        "pattern_altitude_ft_msl": {
          "minimum": 0,
          "title": "Pattern Altitude Ft Msl",
          "type": "number"
        },
        "rule_version": {
          "const": "CAC_REV19_8_4_9_V4",
          "default": "CAC_REV19_8_4_9_V4",
          "title": "Rule Version",
          "type": "string"
        },
        "selected_pattern_altitude_ft_msl": {
          "minimum": 100,
          "multipleOf": 100,
          "title": "Selected Pattern Altitude Ft Msl",
          "type": "integer"
        },
        "selected_pattern_altitude_source": {
          "$ref": "#/$defs/AdoptedSource"
        },
        "selected_reference_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Selected Reference Fingerprint",
          "type": "string"
        },
        "vrep_node_id": {
          "format": "uuid",
          "title": "Vrep Node Id",
          "type": "string"
        }
      },
      "required": [
        "vrep_node_id",
        "destination_airport_id",
        "distance_nm_exact",
        "effective_distance_nm",
        "airport_elevation_ft_msl",
        "airport_elevation_rounded_ft_msl",
        "derived_pattern_altitude_ft_msl",
        "pattern_altitude_ft_msl",
        "selected_pattern_altitude_ft_msl",
        "selected_pattern_altitude_source",
        "base_vrep_altitude_ft_msl",
        "excess_distance_nm_exact",
        "excess_distance_nm_rounded",
        "automatic_altitude_ft_msl",
        "adopted_altitude_ft_msl",
        "adopted_source",
        "selected_reference_fingerprint"
      ],
      "title": "ArrivalAltitudeResult",
      "type": "object"
    },
    "CheckPointProjection": {
      "additionalProperties": false,
      "properties": {
        "abeam_latitude_deg": {
          "maximum": 90,
          "minimum": -90,
          "title": "Abeam Latitude Deg",
          "type": "number"
        },
        "abeam_longitude_deg": {
          "maximum": 180,
          "minimum": -180,
          "title": "Abeam Longitude Deg",
          "type": "number"
        },
        "along_section_distance_nm": {
          "minimum": 0,
          "title": "Along Section Distance Nm",
          "type": "number"
        },
        "along_track_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Along Track Fraction",
          "type": "number"
        },
        "checkpoint_id": {
          "format": "uuid",
          "title": "Checkpoint Id",
          "type": "string"
        },
        "cross_track_distance_nm": {
          "minimum": 0,
          "title": "Cross Track Distance Nm",
          "type": "number"
        },
        "cumulative_distance_nm": {
          "minimum": 0,
          "title": "Cumulative Distance Nm",
          "type": "number"
        },
        "policy_version": {
          "const": "CP_ABEAM_WGS84_V1",
          "default": "CP_ABEAM_WGS84_V1",
          "title": "Policy Version",
          "type": "string"
        },
        "section_id": {
          "format": "uuid",
          "title": "Section Id",
          "type": "string"
        }
      },
      "required": [
        "checkpoint_id",
        "section_id",
        "abeam_latitude_deg",
        "abeam_longitude_deg",
        "along_track_fraction",
        "along_section_distance_nm",
        "cumulative_distance_nm",
        "cross_track_distance_nm"
      ],
      "title": "CheckPointProjection",
      "type": "object"
    },
    "DerivedPointType": {
      "enum": [
        "RCA",
        "EOC"
      ],
      "title": "DerivedPointType",
      "type": "string"
    },
    "DerivedRoutePoint": {
      "additionalProperties": false,
      "properties": {
        "along_route_distance_nm": {
          "title": "Along Route Distance Nm",
          "type": "number"
        },
        "estimated_time_utc": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Time Utc"
        },
        "latitude_deg": {
          "title": "Latitude Deg",
          "type": "number"
        },
        "longitude_deg": {
          "title": "Longitude Deg",
          "type": "number"
        },
        "section_id": {
          "format": "uuid",
          "title": "Section Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/DerivedPointType"
        }
      },
      "required": [
        "type",
        "section_id",
        "latitude_deg",
        "longitude_deg",
        "along_route_distance_nm"
      ],
      "title": "DerivedRoutePoint",
      "type": "object"
    },
    "FlightPhase": {
      "enum": [
        "CLIMB",
        "CRUISE",
        "DESCENT",
        "VISUAL_ARRIVAL"
      ],
      "title": "FlightPhase",
      "type": "string"
    },
    "FuelPlan": {
      "additionalProperties": false,
      "properties": {
        "additional_gal": {
          "default": 2.8,
          "title": "Additional Gal",
          "type": "number"
        },
        "climb_gal": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Climb Gal"
        },
        "cruise_gal": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cruise Gal"
        },
        "descent_gal": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Descent Gal"
        },
        "extra_endurance_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extra Endurance Seconds"
        },
        "extra_gal": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extra Gal"
        },
        "min_required_gal": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Required Gal"
        },
        "reserve_gal": {
          "default": 12.4,
          "title": "Reserve Gal",
          "type": "number"
        },
        "taxi_runup_gal": {
          "default": 1.5,
          "title": "Taxi Runup Gal",
          "type": "number"
        },
        "tgl_gal": {
          "default": 0.0,
          "title": "Tgl Gal",
          "type": "number"
        },
        "total_usable_gal": {
          "title": "Total Usable Gal",
          "type": "number"
        }
      },
      "required": [
        "total_usable_gal"
      ],
      "title": "FuelPlan",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "acknowledgement_required": {
          "default": false,
          "title": "Acknowledgement Required",
          "type": "boolean"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "section_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Id"
        },
        "segment_sequence": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Segment Sequence"
        },
        "severity": {
          "$ref": "#/$defs/IssueSeverity"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "Issue",
      "type": "object"
    },
    "IssueSeverity": {
      "enum": [
        "BLOCKER",
        "WARNING"
      ],
      "title": "IssueSeverity",
      "type": "string"
    },
    "IterationRecord": {
      "additionalProperties": false,
      "properties": {
        "iteration": {
          "title": "Iteration",
          "type": "integer"
        },
        "max_time_delta_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Time Delta Seconds"
        },
        "representative_times_utc": {
          "additionalProperties": {
            "format": "date-time",
            "type": "string"
          },
          "title": "Representative Times Utc",
          "type": "object"
        }
      },
      "required": [
        "iteration",
        "max_time_delta_seconds",
        "representative_times_utc"
      ],
      "title": "IterationRecord",
      "type": "object"
    },
    "ProjectStatus": {
      "enum": [
        "DRAFT",
        "ROUTE_INCOMPLETE",
        "FORECAST_REQUIRED",
        "WEATHER_PENDING",
        "MANUAL_INPUT_REQUIRED",
        "CALCULATION_WARNING",
        "READY_FOR_REVIEW",
        "READY_FOR_COPY",
        "SNAPSHOTTED"
      ],
      "title": "ProjectStatus",
      "type": "string"
    },
    "SectionResult": {
      "additionalProperties": false,
      "properties": {
        "cas_kt": {
          "$ref": "#/$defs/AdoptedValue_float_"
        },
        "cumulative_distance_nm": {
          "$ref": "#/$defs/AdoptedValue_float_"
        },
        "cumulative_ete_seconds": {
          "$ref": "#/$defs/AdoptedValue_float_"
        },
        "eto_utc": {
          "$ref": "#/$defs/AdoptedValue_datetime_"
        },
        "from_name": {
          "title": "From Name",
          "type": "string"
        },
        "ground_speed_kt": {
          "$ref": "#/$defs/AdoptedValue_float_"
        },
        "loss_time_seconds": {
          "minimum": 0,
          "title": "Loss Time Seconds",
          "type": "number"
        },
        "magnetic_course_deg": {
          "$ref": "#/$defs/AdoptedValue_float_"
        },
        "magnetic_heading_deg": {
          "$ref": "#/$defs/AdoptedValue_float_"
        },
        "performance_metadata": {
          "additionalProperties": true,
          "title": "Performance Metadata",
          "type": "object"
        },
        "phase": {
          "$ref": "#/$defs/FlightPhase"
        },
        "planned_altitude_ft_msl": {
          "$ref": "#/$defs/AdoptedValue_float_"
        },
        "pressure_altitude_exact_ft": {
          "$ref": "#/$defs/AdoptedValue_float_"
        },
        "pressure_altitude_planning_ft": {
          "$ref": "#/$defs/AdoptedValue_float_"
        },
        "remaining_fuel_gal": {
          "$ref": "#/$defs/AdoptedValue_float_"
        },
        "safe_enroute_altitude_ft_msl": {
          "$ref": "#/$defs/AdoptedValue_float_"
        },
        "section_fuel_gal": {
          "$ref": "#/$defs/AdoptedValue_float_"
        },
        "section_id": {
          "format": "uuid",
          "title": "Section Id",
          "type": "string"
        },
        "segment_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Segment Label"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "tas_kt": {
          "$ref": "#/$defs/AdoptedValue_float_"
        },
        "temperature_c": {
          "$ref": "#/$defs/AdoptedValue_float_"
        },
        "to_name": {
          "title": "To Name",
          "type": "string"
        },
        "true_course_deg": {
          "$ref": "#/$defs/AdoptedValue_float_"
        },
        "variation_deg_east": {
          "$ref": "#/$defs/AdoptedValue_float_"
        },
        "wca_deg": {
          "$ref": "#/$defs/AdoptedValue_float_"
        },
        "wind_direction_deg_from": {
          "$ref": "#/$defs/AdoptedValue_float_"
        },
        "wind_speed_kt": {
          "$ref": "#/$defs/AdoptedValue_float_"
        },
        "zone_distance_nm": {
          "$ref": "#/$defs/AdoptedValue_float_"
        },
        "zone_ete_seconds": {
          "$ref": "#/$defs/AdoptedValue_float_"
        }
      },
      "required": [
        "section_id",
        "sequence",
        "phase",
        "from_name",
        "to_name",
        "planned_altitude_ft_msl",
        "safe_enroute_altitude_ft_msl",
        "loss_time_seconds",
        "pressure_altitude_exact_ft",
        "pressure_altitude_planning_ft",
        "true_course_deg",
        "variation_deg_east",
        "magnetic_course_deg",
        "wind_direction_deg_from",
        "wind_speed_kt",
        "wca_deg",
        "magnetic_heading_deg",
        "temperature_c",
        "cas_kt",
        "tas_kt",
        "ground_speed_kt",
        "zone_distance_nm",
        "cumulative_distance_nm",
        "zone_ete_seconds",
        "cumulative_ete_seconds",
        "eto_utc",
        "section_fuel_gal",
        "remaining_fuel_gal"
      ],
      "title": "SectionResult",
      "type": "object"
    },
    "ValueState": {
      "enum": [
        "AUTO",
        "MANUAL_OVERRIDE",
        "FIXED_RULE",
        "PERFORMANCE_TABLE",
        "UNAVAILABLE",
        "WARNING"
      ],
      "title": "ValueState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "arrival_altitude": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArrivalAltitudeResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "check_point_projections": {
      "items": {
        "$ref": "#/$defs/CheckPointProjection"
      },
      "title": "Check Point Projections",
      "type": "array"
    },
    "converged": {
      "default": false,
      "title": "Converged",
      "type": "boolean"
    },
    "derived_points": {
      "items": {
        "$ref": "#/$defs/DerivedRoutePoint"
      },
      "title": "Derived Points",
      "type": "array"
    },
    "fuel_plan": {
      "$ref": "#/$defs/FuelPlan"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "title": "Issues",
      "type": "array"
    },
    "iterations": {
      "items": {
        "$ref": "#/$defs/IterationRecord"
      },
      "title": "Iterations",
      "type": "array"
    },
    "performance_table_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Performance Table Version"
    },
    "policy_version": {
      "title": "Policy Version",
      "type": "string"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "qnh_hpa": {
      "$ref": "#/$defs/AdoptedValue_float_"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/SectionResult"
      },
      "title": "Sections",
      "type": "array"
    },
    "selected_forecast_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Selected Forecast Run Id"
    },
    "status": {
      "$ref": "#/$defs/ProjectStatus"
    }
  },
  "required": [
    "project_id",
    "selected_forecast_run_id",
    "qnh_hpa",
    "fuel_plan",
    "status",
    "policy_version"
  ],
  "title": "CalculationOutcome",
  "type": "object"
}
