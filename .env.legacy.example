# Legacy本番専用のrelease/1.x checkoutで、このファイルを.envとして使用する。
# 値は稼働中の正しい設定から移す。秘密値をGitやログに出さない。
# 初回切替手順: docs/operations/legacy-compose.md
COMPOSE_FILE=compose.yaml
COMPOSE_PROJECT_NAME=autonavlog
AUTONAVLOG_IMAGE=autonavlog:legacy
AUTONAVLOG_DATA_VOLUME=autonavlog_autonavlog-data
AUTONAVLOG_DATA_EXTERNAL=true
AUTONAVLOG_BIND_ADDRESS=127.0.0.1
AUTONAVLOG_HOST_PORT=8123
AUTONAVLOG_TRUSTED_LOCAL_IDENTITY=
AUTONAVLOG_SESSION_COOKIE_SECURE=true
AUTONAVLOG_CLOUDFLARE_TEAM_DOMAIN=
AUTONAVLOG_CLOUDFLARE_ACCESS_AUDIENCE=
AUTONAVLOG_FIREBASE_PROJECT_ID=
AUTONAVLOG_FIREBASE_API_KEY=
AUTONAVLOG_FIREBASE_AUTH_DOMAIN=
AUTONAVLOG_FIREBASE_APP_ID=
AUTONAVLOG_NAVMATE_URL=https://navmate.yuto24.com/
